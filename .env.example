# Backend service variables for Railway
SPRING_PROFILES_ACTIVE=prod

# Paste the Neon pooled connection string as-is. The app also accepts
# SPRING_DATASOURCE_URL if you prefer a jdbc:postgresql:// URL.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require

# Set this after Railway generates the frontend public domain.
SURVEYAI_WEB_ALLOWED_ORIGINS=https://surveyai-frontend.up.railway.app

# Keep disabled unless you want seed data on a fresh database.
SURVEYAI_SEED_ENABLED=false
SURVEYAI_SEED_OWNER_EMAIL=owner@example.com
SURVEYAI_SEED_OWNER_PASSWORD=replace-with-a-long-random-password

# Optional live calling provider configuration.
SURVEYAI_CALLING_ACTIVE_PROVIDER=MOCK
SURVEYAI_CALLING_MOCK_ENABLED=true
SURVEYAI_CALLING_ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
PUBLIC_WEBHOOK_BASE_URL=https://surveyai-backend.up.railway.app

# Optional call queue settings (defaults shown). New calls start only inside the
# calling hours, in each company's timezone; a company can override them with a
# "callingHours" object in company.metadata_json.
SURVEYAI_CALLING_HOURS_START=10:00
SURVEYAI_CALLING_HOURS_END=20:00
SURVEYAI_CALLING_DAYS=MONDAY,TUESDAY,WEDNESDAY,THURSDAY,FRIDAY,SATURDAY,SUNDAY
SURVEYAI_CALLING_MAX_CONCURRENT_CALLS_PER_OPERATION=1
SURVEYAI_CALLING_RETRY_DELAY=2h
